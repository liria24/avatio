{
    "name": "avatio",
    "version": "1.11.0",
    "private": true,
    "author": "Liria",
    "repository": {
        "type": "git",
        "url": "https://github.com/liria24/avatio.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "vp run typecheck:packages && nuxt typecheck && vp run typecheck:tests",
        "typecheck:packages": "tsc -p packages/core/tsconfig.json && tsc -p packages/nuxt/tsconfig.json && tsc -p packages/cloudflare/tsconfig.json",
        "typecheck:tests": "tsc -p test/tsconfig.json && vue-tsc -p test/unit/app/tsconfig.json && tsc -p test/browser/tsconfig.json",
        "lint": "vp lint",
        "lint:fix": "vp lint --fix",
        "format": "vp fmt --check",
        "format:fix": "vp fmt",
        "lint:unused": "nuxt prepare && knip",
        "test": "vp test run --project unit",
        "test:watch": "vp test --watch --project unit",
        "test:unit": "vp test run --project unit",
        "test:ci": "vp test run",
        "test:integration": "vp test run --project integration",
        "test:http": "vp test run --project http",
        "test:bindings": "vp test run --project cloudflare",
        "test:browser": "playwright test",
        "test:browser:smoke": "playwright test --project chromium-smoke",
        "test:browser:extended": "playwright test --project chromium-extended --project firefox --project webkit --project mobile",
        "test:nuxt": "vp test run --project nuxt",
        "test:cloudflare": "vp test run --project unit --project integration test/unit/cloudflareConfiguration.spec.ts test/unit/deployment.spec.ts test/unit/server/previewRuntime.spec.ts test/integration/server/previewRuntime.spec.ts test/integration/catalog/leaseFencing.spec.ts",
        "config:check:development": "node scripts/stage.ts check development",
        "config:check:production": "node scripts/stage.ts check production",
        "plan:development": "node scripts/stage.ts plan development",
        "plan:production": "node scripts/stage.ts plan production",
        "deploy:development": "node scripts/stage.ts deploy development",
        "deploy:production": "node scripts/stage.ts deploy production",
        "infra:adopt:development": "node scripts/stage.ts adopt development",
        "infra:adopt:production": "node scripts/stage.ts adopt production",
        "db:seed:local": "node scripts/seedLocalD1.ts",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "@avatio/cloudflare": "workspace:*",
        "@avatio/core": "workspace:*",
        "@avatio/nuxt": "workspace:*",
        "@better-auth/drizzle-adapter": "1.7.6",
        "@comark/nuxt": "catalog:",
        "@formkit/drag-and-drop": "0.6.1",
        "@iconify-json/fluent-color": "1.2.21",
        "@iconify-json/lucide": "1.2.131",
        "@iconify-json/mingcute": "1.2.8",
        "@iconify-json/simple-icons": "1.2.97",
        "@iconify-json/svg-spinners": "1.2.4",
        "@iconify-json/twemoji": "1.2.5",
        "@liria24/og-image": "^1.3.3",
        "@nuxt/fonts": "^0.14.0",
        "@nuxt/image": "2.1.0",
        "@nuxt/scripts": "^1.3.9",
        "@nuxt/ui": "4.11.2",
        "@nuxtjs/better-auth": "0.3.4",
        "@nuxtjs/device": "4.0.0",
        "@nuxtjs/i18n": "10.6.0",
        "@nuxtjs/robots": "6.2.3",
        "@nuxtjs/sitemap": "8.5.1",
        "@tanstack/vue-form": "2.0.0-alpha.2",
        "@vite-pwa/nuxt": "1.1.1",
        "@vueuse/nuxt": "15.0.0",
        "@vueuse/router": "15.0.0",
        "@yeger/vue-masonry-wall": "6.1.4",
        "better-auth": "1.7.6",
        "canvas-confetti": "1.9.4",
        "cn": "0.4.0",
        "comark": "catalog:",
        "consola": "^3.4.2",
        "drizzle-orm": "catalog:",
        "extract-colors": "^4.2.1",
        "http-status-codes": "^2.3.0",
        "insight-ts": "0.0.1-alpha.1",
        "motion-v": "^2.4.4",
        "nanoid": "^3.3.19",
        "nuxt": "catalog:",
        "nuxt-files-sdk": "https://pkg.pr.new/nuxt-files-sdk@2d511bb",
        "nuxt-link-checker": "5.3.0",
        "nuxt-schema-org": "6.3.2",
        "nuxt-seo-utils": "8.5.1",
        "pngjs": "^7.0.0",
        "postal-mime": "^3.0.0",
        "sanitize-html": "2.17.7",
        "ufo": "^1.6.4",
        "vue": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@alchemy.run/frontend-frameworks": "2.0.0-beta.79",
        "@axe-core/playwright": "4.13.0",
        "@cloudflare/workers-types": "^5.20260924.1",
        "@dotenvx/dotenvx": "2.30.0",
        "@effect/platform-bun": "4.0.0-rc.117",
        "@nuxt/a11y": "1.0.0-alpha.1",
        "@nuxt/hints": "1.1.4",
        "@nuxt/test-utils": "4.3.2",
        "@playwright/test": "1.63.0",
        "@types/canvas-confetti": "1.9.0",
        "@types/node": "26.6.2",
        "@types/pngjs": "^6.0.5",
        "@types/sanitize-html": "2.16.1",
        "@vue/test-utils": "^2.5.1",
        "alchemy": "2.0.0-beta.79",
        "cf": "1.0.0-beta.11",
        "drizzle-kit": "catalog:",
        "effect": "4.0.0-rc.117",
        "fake-indexeddb": "^6.2.5",
        "happy-dom": "^20.14.5",
        "ipx": "4.0.0-beta.1",
        "knip": "6.38.0",
        "miniflare": "5.20260930.0-alpha",
        "nitropack": "^2.13.4",
        "taze": "^21.1.0",
        "typescript": "6.0.3",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "vitest-environment-nuxt": "2.0.0",
        "vue-tsc": "^3.3.11"
    },
    "overrides": {
        "vite": "catalog:",
        "vitest": "catalog:",
        "vue": "catalog:"
    },
    "packageManager": "bun@1.4.2",
    "catalog": {
        "@comark/nuxt": "0.7.0",
        "@nuxt/kit": "4.6.0",
        "@nuxt/schema": "4.6.0",
        "comark": "0.7.0",
        "comark-content": "0.4.1",
        "drizzle-kit": "1.0.0-rc.4",
        "drizzle-orm": "1.0.0-rc.4",
        "nuxt": "4.6.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.0",
        "vitest": "5.0.1",
        "vite-plus": "1.0.0-rc.0",
        "vue": "3.6.0-rc.9",
        "zod": "4.6.5"
    }
}
