{
    "name": "avatio",
    "version": "1.10.3",
    "private": true,
    "author": "Liria",
    "repository": {
        "type": "git",
        "url": "https://github.com/liria24/avatio.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "bun scripts/stage.ts dev development",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "bun run typecheck:packages && nuxt typecheck",
        "typecheck:packages": "tsc -p packages/core/tsconfig.json && tsc -p packages/nuxt/tsconfig.json && tsc -p packages/cloudflare/tsconfig.json",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:unit": "vitest --project unit",
        "test:nuxt": "vitest --project nuxt",
        "config:check:development": "bun scripts/stage.ts check development",
        "config:check:production": "bun scripts/stage.ts check production",
        "plan:development": "bun scripts/stage.ts plan development",
        "plan:production": "bun scripts/stage.ts plan production",
        "deploy:development": "bun scripts/stage.ts deploy development",
        "deploy:production": "bun scripts/stage.ts deploy production",
        "db:seed:local": "bun scripts/seedLocalD1.ts",
        "db:generate": "drizzle-kit generate",
        "drizzle:generate": "bun run db:generate"
    },
    "dependencies": {
        "@avatio/cloudflare": "workspace:*",
        "@avatio/core": "workspace:*",
        "@avatio/nuxt": "workspace:*",
        "@aws-sdk/client-s3": "^3.1117.0",
        "@aws-sdk/lib-storage": "^3.1117.0",
        "@aws-sdk/s3-presigned-post": "^3.1117.0",
        "@aws-sdk/s3-request-presigner": "^3.1117.0",
        "@better-auth/drizzle-adapter": "1.7.1",
        "@comark/nuxt": "0.6.2",
        "@iconify-json/fluent-color": "1.2.21",
        "@iconify-json/lucide": "1.2.126",
        "@iconify-json/mingcute": "1.2.8",
        "@iconify-json/simple-icons": "1.2.93",
        "@iconify-json/svg-spinners": "1.2.4",
        "@iconify-json/twemoji": "1.2.5",
        "@liria24/og-image": "^1.3.3",
        "@nuxt/fonts": "^0.14.0",
        "@nuxt/image": "2.1.0",
        "@nuxt/scripts": "^1.3.8",
        "@nuxt/ui": "4.11.0",
        "@nuxtjs/better-auth": "0.2.0",
        "@nuxtjs/device": "4.0.0",
        "@nuxtjs/i18n": "10.6.0",
        "@nuxtjs/robots": "6.2.0",
        "@nuxtjs/sitemap": "8.5.0",
        "@stefanobartoletti/nuxt-social-share": "3.2.0",
        "@vite-pwa/nuxt": "1.1.1",
        "@vueuse/nuxt": "14.4.0",
        "@vueuse/router": "14.4.0",
        "@yeger/vue-masonry-wall": "6.1.4",
        "better-auth": "1.7.1",
        "canvas-confetti": "1.9.4",
        "clsx": "2.1.1",
        "drizzle-orm": "1.0.0-rc.4",
        "extract-colors": "^4.2.1",
        "files-sdk": "^2.2.5",
        "http-status-codes": "^2.3.0",
        "motion-v": "^2.4.0",
        "nuxt": "4.5.2",
        "nuxt-link-checker": "5.3.0",
        "nuxt-schema-org": "6.3.0",
        "nuxt-seo-utils": "8.4.2",
        "pngjs": "^7.0.0",
        "postal-mime": "^3.0.0",
        "sanitize-html": "2.17.7",
        "vue-data-ui": "3.23.14",
        "vue-draggable-plus": "0.6.1",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@alchemy.run/frontend-frameworks": "2.0.0-beta.74",
        "@cloudflare/workers-types": "^5.20260823.1",
        "@dotenvx/dotenvx": "2.21.0",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@nuxt/a11y": "1.0.0-alpha.1",
        "@nuxt/hints": "1.1.4",
        "@nuxt/test-utils": "4.1.0",
        "@types/canvas-confetti": "1.9.0",
        "@types/node": "26.3.0",
        "@types/pngjs": "^6.0.5",
        "@types/sanitize-html": "2.16.1",
        "@vue/test-utils": "^2.4.11",
        "alchemy": "2.0.0-beta.74",
        "drizzle-kit": "1.0.0-rc.4",
        "effect": "4.0.0-rc.111",
        "happy-dom": "^20.11.6",
        "oxfmt": "^0.65.0",
        "oxlint": "^1.80.0",
        "oxlint-tsgolint": "^7.0.2001",
        "taze": "^21.1.0",
        "typescript": "6.0.3",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11"
    },
    "packageManager": "bun@1.4.0"
}
