{
    "name": "avatio",
    "version": "1.10.3",
    "private": true,
    "author": "Liria",
    "repository": {
        "type": "git",
        "url": "https://github.com/liria24/avatio.git"
    },
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "bun run db:migrate:local && nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:unit": "vitest --project unit",
        "test:nuxt": "vitest --project nuxt",
        "cf:types": "wrangler types --config .output/server/wrangler.json",
        "cf:check": "wrangler deploy --dry-run --config .output/server/wrangler.json",
        "release": "bumpp",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply avatio --local",
        "db:migrate:remote": "wrangler d1 migrations apply avatio --remote",
        "db:import:neon": "bun scripts/database/neon-to-d1.ts",
        "deploy": "bun run db:migrate:remote && wrangler deploy --config .output/server/wrangler.json",
        "deploy:preview": "bun scripts/deploy-preview.ts",
        "drizzle:generate": "bun run db:generate",
        "changelogen": "changelogen --hideAuthorEmail"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1112.0",
        "@aws-sdk/lib-storage": "^3.1112.0",
        "@aws-sdk/s3-presigned-post": "^3.1112.0",
        "@aws-sdk/s3-request-presigner": "^3.1112.0",
        "@better-auth/drizzle-adapter": "1.7.0",
        "@comark/nuxt": "0.6.2",
        "@iconify-json/fluent-color": "1.2.21",
        "@iconify-json/lucide": "1.2.123",
        "@iconify-json/mingcute": "1.2.8",
        "@iconify-json/simple-icons": "1.2.93",
        "@iconify-json/svg-spinners": "1.2.4",
        "@iconify-json/twemoji": "1.2.5",
        "@liria24/og-image": "^1.3.3",
        "@nuxt/content": "3.15.2",
        "@nuxt/fonts": "^0.14.0",
        "@nuxt/image": "2.1.0",
        "@nuxt/scripts": "^1.3.6",
        "@nuxt/ui": "4.10.0",
        "@nuxtjs/device": "4.0.0",
        "@nuxtjs/i18n": "10.6.0",
        "@nuxtjs/robots": "6.1.4",
        "@nuxtjs/sitemap": "8.3.4",
        "@stefanobartoletti/nuxt-social-share": "3.2.0",
        "@vite-pwa/nuxt": "1.1.1",
        "@vueuse/nuxt": "14.4.0",
        "@vueuse/router": "14.4.0",
        "@yeger/vue-masonry-wall": "6.1.4",
        "ai": "7.0.66",
        "better-auth": "1.7.0",
        "canvas-confetti": "1.9.4",
        "clsx": "2.1.1",
        "drizzle-orm": "1.0.0-rc.4",
        "extract-colors": "^4.2.1",
        "files-sdk": "^2.2.5",
        "http-status-codes": "^2.3.0",
        "motion-v": "^2.4.0",
        "nuxt": "4.5.2",
        "nuxt-link-checker": "5.2.0",
        "nuxt-schema-org": "6.2.9",
        "nuxt-seo-utils": "8.4.2",
        "pngjs": "^7.0.0",
        "postal-mime": "^3.0.0",
        "sanitize-html": "2.17.7",
        "vue-data-ui": "3.23.6",
        "vue-draggable-plus": "0.6.1",
        "workers-ai-provider": "^4.0.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260818.1",
        "@nuxt/a11y": "1.0.0-alpha.1",
        "@nuxt/hints": "1.1.4",
        "@nuxt/test-utils": "4.1.0",
        "@types/canvas-confetti": "1.9.0",
        "@types/node": "26.2.0",
        "@types/pngjs": "^6.0.5",
        "@types/sanitize-html": "2.16.1",
        "@vue/test-utils": "^2.4.11",
        "bumpp": "12.2.1",
        "changelogen": "^0.6.2",
        "drizzle-kit": "1.0.0-rc.4",
        "happy-dom": "^20.11.2",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "taze": "^21.1.0",
        "typescript": "6.0.3",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.10",
        "wrangler": "^4.123.0"
    },
    "overrides": {
        "vue": "latest"
    },
    "packageManager": "bun@1.3.14"
}
