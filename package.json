{
    "name": "avatio",
    "version": "1.11.0",
    "private": true,
    "author": "Liria",
    "repository": {
        "type": "git",
        "url": "https://github.com/liria24/avatio.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "vp run typecheck:packages && nuxt typecheck && vp run typecheck:tests",
        "typecheck:packages": "tsc -p packages/core/tsconfig.json && tsc -p packages/nuxt/tsconfig.json && tsc -p packages/cloudflare/tsconfig.json",
        "typecheck:tests": "tsc -p test/tsconfig.json && vue-tsc -p test/unit/app/tsconfig.json",
        "lint": "vp lint",
        "lint:fix": "vp lint --fix",
        "format": "vp fmt --check",
        "format:fix": "vp fmt",
        "lint:unused": "nuxt prepare && knip",
        "test": "vp test run",
        "test:watch": "vp test --watch",
        "test:unit": "vp test run --project unit",
        "test:nuxt": "vp test run --project nuxt",
        "config:check:development": "node scripts/stage.ts check development",
        "config:check:production": "node scripts/stage.ts check production",
        "plan:development": "node scripts/stage.ts plan development",
        "plan:production": "node scripts/stage.ts plan production",
        "deploy:development": "node scripts/stage.ts deploy development",
        "deploy:production": "node scripts/stage.ts deploy production",
        "infra:adopt:development": "node scripts/stage.ts adopt development",
        "infra:adopt:production": "node scripts/stage.ts adopt production",
        "db:seed:local": "node scripts/seedLocalD1.ts",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "@avatio/cloudflare": "workspace:*",
        "@avatio/core": "workspace:*",
        "@avatio/nuxt": "workspace:*",
        "@aws-sdk/client-s3": "^3.1131.0",
        "@aws-sdk/lib-storage": "^3.1131.0",
        "@aws-sdk/s3-presigned-post": "^3.1131.0",
        "@aws-sdk/s3-request-presigner": "^3.1131.0",
        "@better-auth/drizzle-adapter": "1.7.4",
        "@comark/nuxt": "0.7.0",
        "@formkit/drag-and-drop": "0.6.1",
        "@iconify-json/fluent-color": "1.2.21",
        "@iconify-json/lucide": "1.2.131",
        "@iconify-json/mingcute": "1.2.8",
        "@iconify-json/simple-icons": "1.2.95",
        "@iconify-json/svg-spinners": "1.2.4",
        "@iconify-json/twemoji": "1.2.5",
        "@liria24/og-image": "^1.3.3",
        "@nuxt/fonts": "^0.14.0",
        "@nuxt/image": "2.1.0",
        "@nuxt/scripts": "^1.3.9",
        "@nuxt/ui": "4.11.1",
        "@nuxtjs/better-auth": "0.3.3",
        "@nuxtjs/device": "4.0.0",
        "@nuxtjs/i18n": "10.6.0",
        "@nuxtjs/robots": "6.2.2",
        "@nuxtjs/sitemap": "8.5.0",
        "@stefanobartoletti/nuxt-social-share": "3.2.1",
        "@tanstack/vue-form": "2.0.0-alpha.2",
        "@vite-pwa/nuxt": "1.1.1",
        "@vueuse/nuxt": "14.4.0",
        "@vueuse/router": "14.4.0",
        "@yeger/vue-masonry-wall": "6.1.4",
        "better-auth": "1.7.4",
        "canvas-confetti": "1.9.4",
        "cn": "0.2.6",
        "comark": "0.7.0",
        "consola": "^3.4.2",
        "drizzle-orm": "1.0.0-rc.4",
        "extract-colors": "^4.2.1",
        "http-status-codes": "^2.3.0",
        "insight-ts": "0.0.1-alpha.1",
        "motion-v": "^2.4.2",
        "nanoid": "^3.3.19",
        "nuxt": "4.5.2",
        "nuxt-files-sdk": "^0.0.4",
        "nuxt-link-checker": "5.3.0",
        "nuxt-schema-org": "6.3.1",
        "nuxt-seo-utils": "8.5.0",
        "pngjs": "^7.0.0",
        "postal-mime": "^3.0.0",
        "sanitize-html": "2.17.7",
        "ufo": "^1.6.4",
        "vue": "3.6.0-rc.8",
        "zod": "4.6.2"
    },
    "devDependencies": {
        "@alchemy.run/frontend-frameworks": "2.0.0-beta.76",
        "@cloudflare/workers-types": "^5.20260911.1",
        "@dotenvx/dotenvx": "2.24.1",
        "@effect/platform-bun": "4.0.0-rc.112",
        "@nuxt/a11y": "1.0.0-alpha.1",
        "@nuxt/hints": "1.1.4",
        "@nuxt/test-utils": "4.3.2",
        "@types/canvas-confetti": "1.9.0",
        "@types/node": "26.5.1",
        "@types/pngjs": "^6.0.5",
        "@types/sanitize-html": "2.16.1",
        "@vue/test-utils": "^2.5.0",
        "alchemy": "2.0.0-beta.76",
        "drizzle-kit": "1.0.0-rc.4",
        "effect": "4.0.0-rc.112",
        "fake-indexeddb": "^6.2.5",
        "files-sdk": "2.4.1",
        "happy-dom": "^20.14.5",
        "ipx": "4.0.0-beta.1",
        "knip": "6.35.1",
        "nitropack": "^2.13.4",
        "taze": "^21.1.0",
        "typescript": "6.0.3",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "vitest-environment-nuxt": "2.0.0",
        "vue-tsc": "^3.3.11"
    },
    "overrides": {
        "@effect/platform-node": "4.0.0-rc.112",
        "@effect/platform-node-shared": "4.0.0-rc.112",
        "@effect/sql-d1": "4.0.0-rc.112",
        "@effect/sql-sqlite-do": "4.0.0-rc.112",
        "@effect/vitest": "4.0.0-rc.112",
        "vite": "catalog:",
        "vitest": "catalog:",
        "vue": "3.6.0-rc.7"
    },
    "packageManager": "bun@1.4.2",
    "catalog": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
        "vitest": "4.1.11",
        "vite-plus": "0.3.1"
    }
}
