{
    "name": "avatio",
    "version": "1.10.2",
    "private": true,
    "author": "Liria",
    "repository": {
        "type": "git",
        "url": "https://github.com/liria24/avatio.git"
    },
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "bun run packages:build && nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "typecheck": "nuxt typecheck",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:unit": "vitest --project unit",
        "test:nuxt": "vitest --project nuxt",
        "packages:build": "bun run --filter './packages/*' build",
        "cf:types": "wrangler --cwd .output types",
        "cf:check": "wrangler --cwd .output deploy --dry-run",
        "release": "bumpp",
        "drizzle:generate": "drizzle-kit generate",
        "changelogen": "changelogen --hideAuthorEmail"
    },
    "dependencies": {
        "@avatio/bot-notifier": "workspace:*",
        "@avatio/ungh": "workspace:*",
        "@aws-sdk/client-s3": "^3.1068.0",
        "@aws-sdk/lib-storage": "^3.1068.0",
        "@aws-sdk/s3-presigned-post": "^3.1068.0",
        "@aws-sdk/s3-request-presigner": "^3.1068.0",
        "@better-auth/drizzle-adapter": "1.6.18",
        "@comark/nuxt": "0.4.0",
        "@iconify-json/fluent-color": "1.2.21",
        "@iconify-json/lucide": "1.2.112",
        "@iconify-json/mingcute": "1.2.7",
        "@iconify-json/simple-icons": "1.2.86",
        "@iconify-json/svg-spinners": "1.2.4",
        "@iconify-json/twemoji": "1.2.5",
        "@liria24/og-image": "^1.3.3",
        "@neondatabase/serverless": "1.1.0",
        "@nuxt/content": "3.14.0",
        "@nuxt/fonts": "^0.14.0",
        "@nuxt/image": "2.0.0",
        "@nuxt/scripts": "^1.2.1",
        "@nuxt/ui": "4.8.2",
        "@nuxtjs/device": "4.0.0",
        "@nuxtjs/i18n": "10.4.0",
        "@nuxtjs/robots": "6.1.1",
        "@nuxtjs/sitemap": "8.2.1",
        "@stefanobartoletti/nuxt-social-share": "3.0.3",
        "@vite-pwa/nuxt": "1.1.1",
        "@vueuse/nuxt": "14.3.0",
        "@vueuse/router": "^14.3.0",
        "@yeger/vue-masonry-wall": "6.1.1",
        "ai": "6.0.205",
        "better-auth": "1.6.18",
        "canvas-confetti": "1.9.4",
        "clsx": "2.1.1",
        "drizzle-orm": "1.0.0-rc.3",
        "extract-colors": "^4.2.1",
        "files-sdk": "^1.9.0",
        "http-status-codes": "^2.3.0",
        "motion-v": "^2.3.0",
        "nuxt": "4.4.8",
        "nuxt-link-checker": "5.1.0",
        "nuxt-schema-org": "6.2.1",
        "nuxt-seo-utils": "8.3.1",
        "pngjs": "^7.0.0",
        "postal-mime": "^2.7.4",
        "sanitize-html": "2.17.5",
        "vue-data-ui": "3.21.4",
        "vue-draggable-plus": "0.6.1",
        "workers-ai-provider": "^3.1.14",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20260615.1",
        "@nuxt/a11y": "1.0.0-alpha.1",
        "@nuxt/hints": "1.1.3",
        "@nuxt/test-utils": "4.0.3",
        "@types/canvas-confetti": "1.9.0",
        "@types/node": "25.9.3",
        "@types/pngjs": "^6.0.5",
        "@types/sanitize-html": "2.16.1",
        "@vue/test-utils": "^2.4.11",
        "bumpp": "11.1.0",
        "drizzle-kit": "1.0.0-rc.3",
        "happy-dom": "^20.10.3",
        "oxfmt": "^0.54.0",
        "oxlint": "^1.69.0",
        "oxlint-tsgolint": "^0.23.0",
        "taze": "^19.14.1",
        "typescript": "6.0.3",
        "vitest": "^4.1.8",
        "vue-tsc": "^3.3.5",
        "wrangler": "^4.100.0"
    },
    "overrides": {
        "vite": "^8.0.0",
        "vue": "latest"
    },
    "packageManager": "bun@1.3.14"
}
