{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreIssues": {
        "server/utils/createAuditLog.ts": ["exports"],
        "server/utils/createNotification.ts": ["exports"]
    },
    "workspaces": {
        "test/fixtures/cf-nitro": {
            "vite": false,
            "entry": [
                "cloudflare.config.ts",
                "vite.config.ts",
                "probe.mjs",
                "verify.mjs",
                "runtime.mjs",
                "migrations.mjs"
            ]
        },
        ".": {
            "entry": [
                "alchemy.run.ts",
                "cloudflare.config.ts",
                "auth.config.ts",
                "files.config.ts",
                "app/auth.config.ts",
                "server/auth.config.ts",
                "oxfmt.config.ts",
                "taze.config.ts",
                "test/helpers/runtimeNetwork.mjs"
            ],
            "ignoreDependencies": [
                "@dotenvx/dotenvx",
                "@iconify-json/fluent-color",
                "@iconify-json/lucide",
                "@iconify-json/mingcute",
                "@iconify-json/simple-icons",
                "@iconify-json/svg-spinners",
                "@iconify-json/twemoji",
                "@nuxt/nitro-server",
                "@vueuse/router"
            ],
            "ignoreUnresolved": ["#nuxt-better-auth"]
        }
    }
}
