{
    "version": 1,
    "source": {
        "name": "avatio-development",
        "account_id": "422bd946004c77eb0d569ec489b40196",
        "compatibility_date": "2026-05-26",
        "compatibility_flags": ["no_handle_cross_request_promise_resolution", "nodejs_compat"],
        "workers_dev": true,
        "preview_urls": false,
        "assets": {
            "binding": "ASSETS",
            "run_worker_first": true
        },
        "routes": [
            {
                "pattern": "dev.avatio.me",
                "custom_domain": true
            }
        ],
        "observability": {
            "enabled": true,
            "head_sampling_rate": 1,
            "logs": {
                "enabled": true,
                "invocation_logs": true,
                "head_sampling_rate": 1,
                "persist": true
            },
            "traces": {
                "enabled": false
            }
        },
        "cache": {
            "enabled": true
        },
        "vars": {
            "STAGE": "development",
            "PUBLIC_SITE_URL": "https://dev.avatio.me",
            "R2_PUBLIC_BASE_URL": "https://images-dev.avatio.me"
        },
        "d1_databases": [
            {
                "binding": "APP_DB",
                "database_id": "1ecd2ac8-1fbf-451b-a985-0f5647654f6d",
                "database_name": "avatio-development",
                "migrations_dir": "drizzle",
                "migrations_pattern": "drizzle/*/migration.sql",
                "migrations_table": "d1_migrations"
            }
        ],
        "kv_namespaces": [
            {
                "binding": "CONTENT_CACHE",
                "id": "b9f92141881547a3aaf9f6f36151c744"
            }
        ],
        "r2_buckets": [
            {
                "binding": "R2",
                "bucket_name": "avatio-development"
            }
        ],
        "flagship": [
            {
                "binding": "FLAGS",
                "app_id": "892f6112-35b8-4968-be81-3f879f0e073a"
            }
        ],
        "ratelimits": [
            {
                "name": "RATE_LIMIT_USER_ACTION",
                "namespace_id": "2201",
                "simple": {
                    "limit": 5,
                    "period": 60
                }
            },
            {
                "name": "RATE_LIMIT_IMAGE",
                "namespace_id": "2202",
                "simple": {
                    "limit": 30,
                    "period": 60
                }
            },
            {
                "name": "RATE_LIMIT_DRAFT",
                "namespace_id": "2203",
                "simple": {
                    "limit": 120,
                    "period": 60
                }
            },
            {
                "name": "RATE_LIMIT_ITEM_RESOLUTION",
                "namespace_id": "2204",
                "simple": {
                    "limit": 32,
                    "period": 60
                }
            }
        ],
        "ai": {
            "binding": "AI"
        },
        "images": {
            "binding": "IMAGES"
        },
        "send_email": [
            {
                "name": "EMAIL",
                "allowed_sender_addresses": ["hello@avatio.me"],
                "allowed_destination_addresses": ["hello@liria.me"]
            }
        ],
        "queues": {
            "producers": [
                {
                    "binding": "ITEM_REVALIDATION_QUEUE",
                    "queue": "item-revalidation-development"
                }
            ],
            "consumers": [
                {
                    "queue": "item-revalidation-development",
                    "max_batch_size": 10,
                    "max_batch_timeout": 5,
                    "max_retries": 3
                }
            ]
        },
        "triggers": {
            "crons": ["0 22 * * *"]
        },
        "version_metadata": {
            "binding": "CF_VERSION_METADATA"
        },
        "secrets": {
            "required": ["NUXT_BETTER_AUTH_SECRET", "TWITTER_CLIENT_SECRET", "OG_IMAGE_SECRET"]
        },
        "no_bundle": true,
        "rules": [
            {
                "type": "ESModule",
                "globs": ["**/*.mjs", "**/*.js"]
            },
            {
                "type": "CompiledWasm",
                "globs": ["**/*.wasm"],
                "fallthrough": true
            }
        ]
    },
