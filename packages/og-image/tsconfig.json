{
    "extends": "./.nitro/types/tsconfig.json",
    "compilerOptions": {
        "strictNullChecks": true,
        "types": ["@cloudflare/workers-types"],
        "paths": {
            "#imports": ["./.nitro/types/nitro-imports"],
            "~/*": ["./*"],
            "@/*": ["./*"],
            "~~/*": ["./*"],
            "@@/*": ["./*"],
            "@src/*": ["./src/*"]
        }
    }
}
